<element><id>UMLSequenceAllInOne</id><coordinates><x>20</x><y>20</y><w>1710</w><h>717</h></coordinates><panel_attributes>title:SD4 AI Budget Recommendation (F07)
obj=User~u
obj=BudgetGUI~g
obj=BudgetController~c
obj=FinancialDataFacade~f
obj=DatabaseService~db
obj=BudgetAI~ai
obj=AIServiceProxy~px
obj=ChatGPTAdapter~ad
