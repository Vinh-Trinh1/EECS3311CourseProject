<element><id>UMLSequenceAllInOne</id><coordinates><x>20</x><y>20</y><w>1875</w><h>825</h></coordinates><panel_attributes>title:SD2 Dashboard and Expense Management (F02, F03, F04)
obj=User~u
obj=DashboardGUI~dg
obj=DashboardController~dc
obj=Account~ac
obj=Category~cat
obj=DatabaseService~db
obj=ExpenseGUI~eg
obj=ExpenseController~ec
obj=ExpenseCategorizerAI~ai
obj=AIServiceProxy~px
